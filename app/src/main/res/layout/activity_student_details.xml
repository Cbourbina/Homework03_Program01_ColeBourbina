<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/btn_v_studentDetails_back"
        android:layout_width="196dp"
        android:layout_height="60dp"
        android:layout_marginBottom="48dp"
        android:text="Back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_v_studentDetails_age"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="12dp"
        android:text="Age"
        android:textSize="24sp"
        app:layout_constraintStart_toEndOf="@+id/tv_v_studentDetails_ageTitle"
        app:layout_constraintTop_toBottomOf="@+id/tv_v_studentDetails_majorTitle" />

    <TextView
        android:id="@+id/tv_v_studentDetails_fname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:text="First Name"
        android:textSize="24sp"
        app:layout_constraintStart_toEndOf="@+id/tv_v_studentDetails_fnameTitle"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_v_studentDetails_lname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Last Name"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="@+id/tv_v_studentDetails_fname"
        app:layout_constraintTop_toBottomOf="@+id/tv_v_studentDetails_fname" />

    <TextView
        android:id="@+id/tv_v_studentDetails_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Email"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="@+id/tv_v_studentDetails_username"
        app:layout_constraintTop_toBottomOf="@+id/tv_v_studentDetails_username" />

    <TextView
        android:id="@+id/tv_v_studentDetails_major"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Major"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="@+id/tv_v_studentDetails_email"
        app:layout_constraintTop_toBottomOf="@+id/tv_v_studentDetails_email" />

    <TextView
        android:id="@+id/tv_v_studentDetails_gpaTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="GPA:"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="@+id/tv_v_studentDetails_major"
        app:layout_constraintTop_toBottomOf="@+id/tv_v_studentDetails_major" />

    <TextView
        android:id="@+id/tv_v_studentDetails_gpa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="12dp"
        android:text="GPA"
        android:textSize="24sp"
        app:layout_constraintStart_toEndOf="@+id/tv_v_studentDetails_gpaTitle"
        app:layout_constraintTop_toBottomOf="@+id/tv_v_studentDetails_major" />

    <TextView
        android:id="@+id/tv_v_studentDetails_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Username"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="@+id/tv_v_studentDetails_lname"
        app:layout_constraintTop_toBottomOf="@+id/tv_v_studentDetails_lname" />

    <TextView
        android:id="@+id/tv_v_studentDetails_ageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:text="Age:"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_v_studentDetails_majorTitle" />

    <TextView
        android:id="@+id/tv_v_studentDetails_majorTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:text="Major:"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_v_studentDetails_emailTitle" />

    <TextView
        android:id="@+id/tv_v_studentDetails_emailTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:text="Email:"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_v_studentDetails_usernameTitle" />

    <TextView
        android:id="@+id/tv_v_studentDetails_fnameTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="First Name:"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_v_studentDetails_lnameTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:text="Last Name:"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_v_studentDetails_fnameTitle" />

    <TextView
        android:id="@+id/tv_v_studentDetails_usernameTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:text="Username:"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_v_studentDetails_lnameTitle" />

    <Button
        android:id="@+id/btn_v_studentDetails_edit"
        android:layout_width="196dp"
        android:layout_height="60dp"
        android:layout_marginBottom="24dp"
        android:text="Edit Student"
        app:layout_constraintBottom_toTopOf="@+id/btn_v_studentDetails_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.479"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>